# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Generated at install/build time
# pdf.js assets, copied from pdfjs-dist by scripts/copy-pdfjs-assets.mjs
public/pdfjs/
