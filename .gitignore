tests/fixtures/out/

# Tauri / Rust
src-tauri/target/
# regenerated by Tauri on every build
src-tauri/gen/schemas/
**/*.rs.bk

# Tests
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# Environment and secrets
.env
.env.*
!.env.example
*.local
*.pem
*.p12
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Claude Code: personal settings stay local; .claude/launch.json is shared
.claude/settings.local.json
